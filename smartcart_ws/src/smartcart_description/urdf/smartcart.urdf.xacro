<?xml version="1.0"?>
<robot name="smartcart" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================================== -->
  <!-- Materials & Colors matching cart.jpg reference design                -->
  <!-- ==================================================================== -->
  <material name="metallic_dark">
    <color rgba="0.18 0.18 0.20 1.0"/>
  </material>

  <material name="brushed_aluminum">
    <color rgba="0.82 0.84 0.86 1.0"/>
  </material>

  <material name="tire_rubber">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="rim_silver">
    <color rgba="0.90 0.90 0.92 1.0"/>
  </material>

  <material name="sensor_red">
    <color rgba="0.85 0.15 0.15 1.0"/>
  </material>

  <material name="metal_hardware">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>

  <!-- ==================================================================== -->
  <!-- Base Footprint (Root dummy link for KDL & planar navigation)         -->
  <!-- ==================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- Base Link: Heavy-duty 4WD Chassis matching cart.jpg                  -->
  <!-- ==================================================================== -->
  <link name="base_link">
    <inertial>
      <!-- Center of mass lowered for rock-solid stability -->
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.3136" ixy="0.0" ixz="0.0"
               iyy="0.6730" iyz="0.0"
               izz="0.8656"/>
    </inertial>

    <!-- Main Enclosure Body (Dark Gunmetal Box) -->
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.66 0.44 0.20"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>

    <!-- Top Brushed Aluminum Deck Plate -->
    <visual>
      <origin xyz="0 0 0.115" rpy="0 0 0"/>
      <geometry>
        <box size="0.68 0.46 0.01"/>
      </geometry>
      <material name="brushed_aluminum"/>
    </visual>

    <!-- Front Hitch / Eyelet Hardware (Visual Detail from cart.jpg) -->
    <visual>
      <origin xyz="0.335 0.0 -0.04" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.015"/>
      </geometry>
      <material name="metal_hardware"/>
    </visual>

    <!-- Front Switch / Port Detail -->
    <visual>
      <origin xyz="0.335 0.08 0.02" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.03"/>
      </geometry>
      <material name="metal_hardware"/>
    </visual>

    <!-- Chassis Collision Geometry (Elevated 5cm above ground clearance) -->
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.66 0.44 0.19"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <material>
      <ambient>0.18 0.18 0.20 1.0</ambient>
      <diffuse>0.20 0.20 0.22 1.0</diffuse>
      <specular>0.4 0.4 0.45 1.0</specular>
    </material>
  </gazebo>

  <!-- ==================================================================== -->
  <!-- Xacro Macro for Rugged 4WD Wheel Assemblies                          -->
  <!-- ==================================================================== -->
  <xacro:macro name="skid_wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.01292" ixy="0.0" ixz="0.0"
                 iyy="0.02250" iyz="0.0"
                 izz="0.01292"/>
      </inertial>

      <!-- Outer Tire Tread (Dark Rugged Rubber) -->
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.15" length="0.10"/>
        </geometry>
        <material name="tire_rubber"/>
      </visual>

      <!-- Inner Wheel Rim / Dish (Silver/White Dish from cart.jpg) -->
      <visual>
        <origin xyz="0 ${y_reflect * 0.01} 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.102"/>
        </geometry>
        <material name="rim_silver"/>
      </visual>

      <!-- Wheel Collision Cylinder -->
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.15" length="0.10"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * 0.22} ${y_reflect * 0.28} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>0.10</mu2>
      <material>
        <ambient>0.08 0.08 0.08 1.0</ambient>
        <diffuse>0.10 0.10 0.10 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </gazebo>
  </xacro:macro>

  <!-- Instantiate 4 Wheels -->
  <xacro:skid_wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:skid_wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:skid_wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:skid_wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- ==================================================================== -->
  <!-- 2D Planar LiDAR Sensor (Mounted high on top aluminum deck)            -->
  <!-- ==================================================================== -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0"
               izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.04"/>
      </geometry>
      <material name="sensor_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.22 0 0.14" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
    <material>
      <ambient>0.85 0.15 0.15 1.0</ambient>
      <diffuse>0.85 0.15 0.15 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
    </material>
  </gazebo>

  <!-- ==================================================================== -->
  <!-- Forward Camera Sensor (Front face centered)                           -->
  <!-- ==================================================================== -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00004" ixy="0.0" ixz="0.0"
               iyy="0.00004" iyz="0.0"
               izz="0.00004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.34 0 0.02" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>/camera/image_raw</topic>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
    <material>
      <ambient>0.2 0.2 0.2 1.0</ambient>
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
    </material>
  </gazebo>

  <!-- ==================================================================== -->
  <!-- Gazebo Harmonic 4WD Skid-Steer DiffDrive System Plugin               -->
  <!-- ==================================================================== -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <!-- 4WD Joint configuration -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.56</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
      <max_linear_acceleration>2.5</max_linear_acceleration>
      <max_angular_acceleration>5.0</max_angular_acceleration>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
