    <model name="shelf_south_d1">
      <static>true</static>
      <pose>-2.0 -6.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.7 0.35 0.55 1.0</ambient><diffuse>0.7 0.35 0.55 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_south_d2">
      <static>true</static>
      <pose>2.0 -6.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.7 0.35 0.55 1.0</ambient><diffuse>0.7 0.35 0.55 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_south_d3">
      <static>true</static>
      <pose>6.0 -6.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
