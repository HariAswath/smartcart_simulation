        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.25 0.55 0.75 1.0</ambient><diffuse>0.25 0.55 0.75 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_north_b2">
      <static>true</static>
      <pose>2.0 6.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.25 0.55 0.75 1.0</ambient><diffuse>0.25 0.55 0.75 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_north_b3">
      <static>true</static>
      <pose>6.0 6.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.25 0.55 0.75 1.0</ambient><diffuse>0.25 0.55 0.75 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_north_b4">
      <static>true</static>
      <pose>10.0 6.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.25 0.55 0.75 1.0</ambient><diffuse>0.25 0.55 0.75 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- South Aisle Rows (Aisle C: y=-3.5, Aisle D: y=-6.5)                -->
    <!-- ================================================================ -->
