    <model name="shelf_south_c1">
      <static>true</static>
      <pose>-2.0 -3.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.3 0.65 0.35 1.0</ambient><diffuse>0.3 0.65 0.35 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_south_c2">
      <static>true</static>
      <pose>2.0 -3.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.3 0.65 0.35 1.0</ambient><diffuse>0.3 0.65 0.35 1.0</diffuse></material>
        </visual>
