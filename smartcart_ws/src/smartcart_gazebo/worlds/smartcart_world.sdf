    <!-- ================================================================ -->
    <!-- Four Simulated People (Independently controllable crowd)          -->
    <!-- ================================================================ -->
    <!-- Human 1: Central Aisle (in front of SmartCart) -->
    <include>
      <name>human_1</name>
      <uri>model://human</uri>
      <pose>2.0 0.0 0.0 0 0 0</pose>
    </include>

    <!-- Human 2: Central Aisle (Bystander, slightly behind Human 1) -->
    <include>
      <name>human_2</name>
      <uri>model://human</uri>
      <pose>3.8 0.4 0.0 0 0 0</pose>
    </include>

    <!-- Human 3: South Aisle C (Dairy / Bakery) -->
    <include>
      <name>human_3</name>
      <uri>model://human</uri>
      <pose>6.0 -4.5 0.0 0 0 0</pose>
    </include>

    <!-- Human 4: East Checkout Area -->
    <include>
      <name>human_4</name>
      <uri>model://human</uri>
      <pose>13.0 3.5 0.0 0 0 0</pose>
    </include>

  </world>
</sdf>
