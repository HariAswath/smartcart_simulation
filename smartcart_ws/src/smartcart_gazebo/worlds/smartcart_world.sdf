          <material><ambient>0.7 0.35 0.55 1.0</ambient><diffuse>0.7 0.35 0.55 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Checkout Counters & Payment Lanes (East Zone)                     -->
    <!-- ================================================================ -->
    <model name="checkout_counter_1">
      <static>true</static>
      <pose>15.0 5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.8 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1.0</ambient><diffuse>0.3 0.3 0.35 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="checkout_counter_2">
      <static>true</static>
      <pose>15.0 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.8 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1.0</ambient><diffuse>0.3 0.3 0.35 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Promotional Displays & Kiosks (East Plaza / South-East)           -->
    <!-- ================================================================ -->
    <model name="promo_display_1">
      <static>true</static>
      <pose>15.0 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.85 0.25 0.25 1.0</ambient><diffuse>0.85 0.25 0.25 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="promo_display_2">
      <static>true</static>
      <pose>15.0 -5.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 1.2 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 1.2 0.9</size></box></geometry>
          <material><ambient>0.85 0.65 0.15 1.0</ambient><diffuse>0.85 0.65 0.15 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Structural Architectural Columns (Static obstacles for safety)   -->
    <!-- ================================================================ -->
    <model name="pillar_1">
      <static>true</static>
      <pose>4.0 1.8 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1.0</ambient><diffuse>0.5 0.5 0.55 1.0</diffuse></material>
