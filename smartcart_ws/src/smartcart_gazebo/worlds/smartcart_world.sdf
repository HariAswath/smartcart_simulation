      <pose>10.0 1.8 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1.0</ambient><diffuse>0.5 0.5 0.55 1.0</diffuse></material>
        </visual>
