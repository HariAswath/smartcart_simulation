<?xml version="1.0"?>
<sdf version="1.8">
  <world name="smartcart_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-4.0 -6.0 6.5 0 0.65 0.75</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>6.0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.85</direction>
    </light>

    <!-- Supermarket / Shopping Mall Floor (26m x 18m) -->
    <model name="supermarket_floor">
      <static>true</static>
      <pose>6.0 0.0 0.0 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>26.0 18.0</size>
            </plane>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>26.0 18.0</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.88 0.88 0.88 1.0</ambient>
            <diffuse>0.88 0.88 0.88 1.0</diffuse>
            <specular>0.25 0.25 0.25 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter Walls -->
    <!-- North Wall (y = 9.0) -->
    <model name="wall_north">
      <static>true</static>
      <pose>6.0 9.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>26.0 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>26.0 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.78 1.0</ambient>
            <diffuse>0.72 0.74 0.78 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South Wall (y = -9.0) -->
    <model name="wall_south">
      <static>true</static>
      <pose>6.0 -9.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>26.0 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>26.0 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.78 1.0</ambient>
            <diffuse>0.72 0.74 0.78 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Wall (x = 19.0) -->
    <model name="wall_east">
      <static>true</static>
      <pose>19.0 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 18.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 18.0 2.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.78 1.0</ambient>
            <diffuse>0.72 0.74 0.78 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall - Segment North (x = -7.0, y = 4.0 to 9.0) -->
    <model name="wall_west_north">
      <static>true</static>
      <pose>-7.0 5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.0 2.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.78 1.0</ambient>
            <diffuse>0.72 0.74 0.78 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall - Segment South (x = -7.0, y = -9.0 to -2.0) -->
    <model name="wall_west_south">
      <static>true</static>
      <pose>-7.0 -5.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 7.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 7.0 2.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.78 1.0</ambient>
            <diffuse>0.72 0.74 0.78 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- North Aisle Rows (Aisle A: y=3.5, Aisle B: y=6.5)                 -->
    <!-- ================================================================ -->
    <!-- Aisle A Shelves (Produce / Pantry Row 1) -->
    <model name="shelf_north_a1">
      <static>true</static>
      <pose>-2.0 3.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.8 0.55 0.2 1.0</ambient><diffuse>0.8 0.55 0.2 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_north_a2">
      <static>true</static>
      <pose>2.0 3.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.8 0.55 0.2 1.0</ambient><diffuse>0.8 0.55 0.2 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_north_a3">
      <static>true</static>
      <pose>6.0 3.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.8 0.55 0.2 1.0</ambient><diffuse>0.8 0.55 0.2 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_north_a4">
      <static>true</static>
      <pose>10.0 3.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.7 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.7 1.6</size></box></geometry>
          <material><ambient>0.8 0.55 0.2 1.0</ambient><diffuse>0.8 0.55 0.2 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Aisle B Shelves (Snacks / Beverages Row 2) -->
    <model name="shelf_north_b1">
